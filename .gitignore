# ─── Build output ────────────────────────────────────────────────────────────
# CMake out-of-source build trees. We never commit anything generated here
# (this also covers build/bin/, FetchContent's build/_deps/, etc.).
build/
out/
cmake-build-*/

# CMake artifacts if a generate ever happens in-tree (it shouldn't)
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/

# ─── Visual Studio (generated by CMake — regenerate, don't commit) ───────────
.vs/
*.sln
*.vcxproj
*.vcxproj.user
*.vcxproj.filters

# Per-user / per-config VS clutter
*.user
*.suo
ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/

# ─── Compiled binaries & intermediates ───────────────────────────────────────
*.obj
*.o
*.exe
*.dll
*.lib
*.a
*.pdb
*.ilk
*.exp
*.idb
*.map

# ─── Editors / other IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/
.cache/
*.swp
*~

# ─── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Engine-specific (mostly forward-looking) ────────────────────────────────
# Runtime logs and crash dumps.
*.log
*.dmp
logs/

# Compiled shader blobs, when the renderer precompiles offline (Phase 1+).
# Source shaders ARE committed; their build output is not.
*.cso
*.dxil

# Cooked / baked content produced by the asset pipeline (Phase 11).
# Keep raw source assets; ignore the cooked output.
cooked/
*.cooked

# Golden-image test artifacts: commit the reference images, ignore the
# actuals/diffs a failing run produces (Phase 1+).
*.actual.png
*.diff.png
tests/_output/
